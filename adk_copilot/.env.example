# Copied to .env by install.py (which fills in the generated values). Never commit the real .env.
GOOGLE_API_KEY={{GOOGLE_API_KEY}}
MCP_API_TOKEN={{MCP_API_TOKEN}}
# Langfuse tracing + prompt management (keys must equal LANGFUSE_INIT_PROJECT_* in gateway/.env.langfuse)
LANGFUSE_HOST=http://host.docker.internal:3000
LANGFUSE_PUBLIC_KEY={{LANGFUSE_PUBLIC_KEY}}
LANGFUSE_SECRET_KEY={{LANGFUSE_SECRET_KEY}}
LANGFUSE_DEBUG=false
LENS_URL=http://host.docker.internal:4318
# LLM calls go through the LiteLLM gateway
LITELLM_MASTER_KEY={{LITELLM_MASTER_KEY}}
OPENAI_API_BASE=http://host.docker.internal:4000
OPENAI_API_KEY={{LITELLM_MASTER_KEY}}
