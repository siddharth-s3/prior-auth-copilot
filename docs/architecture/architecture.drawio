<mxCell id="c59" value="Backup models" style="swimlane;html=1;rounded=1;arcSize=9;startSize=38;fillColor=#F8CECC;strokeColor=#B85450;swimlaneFillColor=#FFFFFF;fontSize=15;fontStyle=1;fontColor=#1A1A1A;collapsible=0;whiteSpace=wrap;strokeWidth=1.5;" vertex="1" parent="litellm"><mxGeometry x="18" y="64" width="430" height="229" as="geometry"/></mxCell>
<mxCell id="c60" value="Shares requests between Gemini and Groq" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c59"><mxGeometry x="14" y="50" width="402" height="40" as="geometry"/></mxCell>
<mxCell id="c61" value="If a model fails, tries the next: 3.5 Flash-Lite, 3 Flash, 3.6 Flash, 4 Hydrogen, Gemma 4 31B" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c59"><mxGeometry x="14" y="99" width="402" height="54" as="geometry"/></mxCell>
<mxCell id="c62" value="On a 429 error it moves on at once; the failing model rests for 60 s" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c59"><mxGeometry x="14" y="162" width="402" height="54" as="geometry"/></mxCell>
