<mxCell id="c66" value="Agent registry (A2A): other apps can find and call our agents" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c63"><mxGeometry x="14" y="148" width="402" height="54" as="geometry"/></mxCell>
