<mxCell id="c64" value="MCP gateway: agents use one address for all tools" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c63"><mxGeometry x="14" y="50" width="402" height="40" as="geometry"/></mxCell>
