<mxCell id="c71" value="gpt-oss-20b: small requests only (8k tokens per minute)" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c70"><mxGeometry x="14" y="50" width="162" height="70" as="geometry"/></mxCell>
