<mxfile host="app.diagrams.net"><diagram name="Architecture" id="preauth-arch"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2126" pageHeight="2392" math="0" shadow="0"><root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="c2" value="Prior Authorization Copilot: Architecture" style="text;html=1;align=center;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1996" height="44" as="geometry"/></mxCell>
<mxCell id="c3" value="Semantic ingestion  ·  smart search over MCP  ·  one LiteLLM gateway for models, tools and agents" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="1996" height="24" as="geometry"/></mxCell>
<mxCell id="ingestion" value="Data Ingestion   ·   always watching for new and changed files" style="swimlane;html=1;rounded=1;arcSize=5;startSize=46;fillColor=#DAE8FC;strokeColor=#6C8EBF;swimlaneFillColor=#FFFFFF;fontSize=20;fontStyle=1;fontColor=#1A1A1A;collapsible=0;whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1992" height="360" as="geometry"/></mxCell>
<mxCell id="c4" value="Watch &amp; detect" style="swimlane;html=1;rounded=1;arcSize=9;startSize=38;fillColor=#F8CECC;strokeColor=#B85450;swimlaneFillColor=#FFFFFF;fontSize=15;fontStyle=1;fontColor=#1A1A1A;collapsible=0;whiteSpace=wrap;strokeWidth=1.5;" vertex="1" parent="ingestion"><mxGeometry x="18" y="64" width="372" height="278" as="geometry"/></mxCell>
<mxCell id="c5" value="A folder watcher runs all the time" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c4"><mxGeometry x="14" y="50" width="344" height="40" as="geometry"/></mxCell>
<mxCell id="c6" value="Reads policies (md, json) and clinical notes (md)" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c4"><mxGeometry x="14" y="99" width="344" height="40" as="geometry"/></mxCell>
<mxCell id="c7" value="Unchanged files are skipped (SHA-256 check)" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c4"><mxGeometry x="14" y="148" width="344" height="40" as="geometry"/></mxCell>
<mxCell id="c8" value="New, changed and deleted files are handled right away" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c4"><mxGeometry x="14" y="197" width="344" height="54" as="geometry"/></mxCell>
<mxCell id="c9" value="Parser" style="swimlane;html=1;rounded=1;arcSize=9;startSize=38;fillColor=#F8CECC;strokeColor=#B85450;swimlaneFillColor=#FFFFFF;fontSize=15;fontStyle=1;fontColor=#1A1A1A;collapsible=0;whiteSpace=wrap;strokeWidth=1.5;" vertex="1" parent="ingestion"><mxGeometry x="414" y="64" width="372" height="278" as="geometry"/></mxCell>
<mxCell id="c10" value="Reads Markdown and JSON files into clean text" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c9"><mxGeometry x="14" y="50" width="344" height="40" as="geometry"/></mxCell>
<mxCell id="c11" value="PaddleOCR reads scanned images and PDFs" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c9"><mxGeometry x="14" y="99" width="344" height="40" as="geometry"/></mxCell>
<mxCell id="c12" value="A copy of the parsed text is saved for audit" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c9"><mxGeometry x="14" y="148" width="344" height="40" as="geometry"/></mxCell>
<mxCell id="c13" value="Chunking" style="swimlane;html=1;rounded=1;arcSize=9;startSize=38;fillColor=#F8CECC;strokeColor=#B85450;swimlaneFillColor=#FFFFFF;fontSize=15;fontStyle=1;fontColor=#1A1A1A;collapsible=0;whiteSpace=wrap;strokeWidth=1.5;" vertex="1" parent="ingestion"><mxGeometry x="810" y="64" width="372" height="278" as="geometry"/></mxCell>
<mxCell id="c14" value="Semantic chunking: split by meaning (section), not by fixed size" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c13"><mxGeometry x="14" y="50" width="344" height="54" as="geometry"/></mxCell>
<mxCell id="c15" value="Notes: one chunk per section (hpi, exam, assessment, plan)" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c13"><mxGeometry x="14" y="113" width="344" height="54" as="geometry"/></mxCell>
<mxCell id="c16" value="Policies: one chunk for the whole document" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c13"><mxGeometry x="14" y="176" width="344" height="40" as="geometry"/></mxCell>
<mxCell id="c17" value="Each chunk has a source label, like NOTE-001#hpi" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c13"><mxGeometry x="14" y="225" width="344" height="40" as="geometry"/></mxCell>
<mxCell id="c18" value="Embedding" style="swimlane;html=1;rounded=1;arcSize=9;startSize=38;fillColor=#F8CECC;strokeColor=#B85450;swimlaneFillColor=#FFFFFF;fontSize=15;fontStyle=1;fontColor=#1A1A1A;collapsible=0;whiteSpace=wrap;strokeWidth=1.5;" vertex="1" parent="ingestion"><mxGeometry x="1206" y="64" width="372" height="278" as="geometry"/></mxCell>
<mxCell id="c19" value="Gemini embedding API (called directly): gemini-embedding-2" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c18"><mxGeometry x="14" y="50" width="344" height="54" as="geometry"/></mxCell>
<mxCell id="c20" value="If it fails: gemini-embedding-001, then text-embedding-004" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c18"><mxGeometry x="14" y="113" width="344" height="54" as="geometry"/></mxCell>
<mxCell id="c21" value="Meaning vector: 3072 numbers per chunk" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c18"><mxGeometry x="14" y="176" width="344" height="40" as="geometry"/></mxCell>
<mxCell id="c22" value="Plus a keyword (BM25) vector for exact words" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c18"><mxGeometry x="14" y="225" width="344" height="40" as="geometry"/></mxCell>
<mxCell id="c23" value="Vector ingestion" style="swimlane;html=1;rounded=1;arcSize=9;startSize=38;fillColor=#F8CECC;strokeColor=#B85450;swimlaneFillColor=#FFFFFF;fontSize=15;fontStyle=1;fontColor=#1A1A1A;collapsible=0;whiteSpace=wrap;strokeWidth=1.5;" vertex="1" parent="ingestion"><mxGeometry x="1602" y="64" width="372" height="278" as="geometry"/></mxCell>
<mxCell id="c24" value="Same file name = update in place (old chunks deleted, new ones saved)" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c23"><mxGeometry x="14" y="50" width="344" height="54" as="geometry"/></mxCell>
<mxCell id="c25" value="A chunk always gets the same ID, so re-runs make no copies" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c23"><mxGeometry x="14" y="113" width="344" height="54" as="geometry"/></mxCell>
<mxCell id="c26" value="Each step is tracked and can be retried" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c23"><mxGeometry x="14" y="176" width="344" height="40" as="geometry"/></mxCell>
<mxCell id="c27" value="Saves to Qdrant :6333" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c23"><mxGeometry x="14" y="225" width="344" height="40" as="geometry"/></mxCell>
<mxCell id="clients" value="Clients" style="swimlane;html=1;rounded=1;arcSize=5;startSize=46;fillColor=#DAE8FC;strokeColor=#6C8EBF;swimlaneFillColor=#FFFFFF;fontSize=20;fontStyle=1;fontColor=#1A1A1A;collapsible=0;whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="576" width="366" height="749" as="geometry"/></mxCell>
<mxCell id="c28" value="CopilotKit UI  ·  :3100" style="swimlane;html=1;rounded=1;arcSize=9;startSize=38;fillColor=#F8CECC;strokeColor=#B85450;swimlaneFillColor=#FFFFFF;fontSize=15;fontStyle=1;fontColor=#1A1A1A;collapsible=0;whiteSpace=wrap;strokeWidth=1.5;" vertex="1" parent="clients"><mxGeometry x="18" y="64" width="330" height="165" as="geometry"/></mxCell>
<mxCell id="c29" value="Case list, details and Adjudicate button. Reviewer actions (accept, override, escalate, clarify, supply data), audit trail and a protocol inspector. Talks AG-UI (with A2UI screens) to :8002, not to the A2A server" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c28"><mxGeometry x="14" y="50" width="302" height="102" as="geometry"/></mxCell>
<mxCell id="c30" value="ADK web  ·  :8000" style="swimlane;html=1;rounded=1;arcSize=9;startSize=38;fillColor=#F8CECC;strokeColor=#B85450;swimlaneFillColor=#FFFFFF;fontSize=15;fontStyle=1;fontColor=#1A1A1A;collapsible=0;whiteSpace=wrap;strokeWidth=1.5;" vertex="1" parent="clients"><mxGeometry x="18" y="253" width="330" height="133" as="geometry"/></mxCell>
<mxCell id="c31" value="Developer screen: runs, traces and agent hand-offs. Runs the agents directly, not through A2A" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c30"><mxGeometry x="14" y="50" width="302" height="70" as="geometry"/></mxCell>
<mxCell id="c32" value="A2A server  ·  :8001" style="swimlane;html=1;rounded=1;arcSize=9;startSize=38;fillColor=#F8CECC;strokeColor=#B85450;swimlaneFillColor=#FFFFFF;fontSize=15;fontStyle=1;fontColor=#1A1A1A;collapsible=0;whiteSpace=wrap;strokeWidth=1.5;" vertex="1" parent="clients"><mxGeometry x="18" y="410" width="330" height="133" as="geometry"/></mxCell>
<mxCell id="c33" value="Same agent team over the A2A protocol. Used only by other apps, through the LiteLLM agent registry" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c32"><mxGeometry x="14" y="50" width="302" height="70" as="geometry"/></mxCell>
<mxCell id="agents" value="Retrieval   ·   Agent Team (Google ADK)" style="swimlane;html=1;rounded=1;arcSize=5;startSize=46;fillColor=#DAE8FC;strokeColor=#6C8EBF;swimlaneFillColor=#FFFFFF;fontSize=20;fontStyle=1;fontColor=#1A1A1A;collapsible=0;whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="490" y="576" width="1096" height="749" as="geometry"/></mxCell>
<mxCell id="c34" value="Supervisor" style="swimlane;html=1;rounded=1;arcSize=9;startSize=38;fillColor=#F8CECC;strokeColor=#B85450;swimlaneFillColor=#FFFFFF;fontSize=15;fontStyle=1;fontColor=#1A1A1A;collapsible=0;whiteSpace=wrap;strokeWidth=1.5;" vertex="1" parent="agents"><mxGeometry x="18" y="64" width="250" height="667" as="geometry"/></mxCell>
<mxCell id="c35" value="Has no data tools. Fetch and memory requests go to one agent; a review is one tool call, run_review" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c34"><mxGeometry x="14" y="50" width="222" height="86" as="geometry"/></mxCell>
<mxCell id="c36" value="run_review runs the review in a fixed order, in code: 1 Clinical evidence, 2 Policy RAG, 3 Coverage, 4 Criteria &amp; quality (it recalls preferences from mem0 first)" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c34"><mxGeometry x="14" y="145" width="222" height="118" as="geometry"/></mxCell>
<mxCell id="c37" value="Code then checks the result (schema, citations exist, recommendation rule), saves it to AG-UI shared state and draws the A2UI screens" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c34"><mxGeometry x="14" y="272" width="222" height="102" as="geometry"/></mxCell>
<mxCell id="c38" value="A person decides: it never approves or denies" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c34"><mxGeometry x="14" y="383" width="222" height="54" as="geometry"/></mxCell>
<mxCell id="c39" value="Specialist agents" style="swimlane;html=1;rounded=1;arcSize=9;startSize=38;fillColor=#F8CECC;strokeColor=#B85450;swimlaneFillColor=#FFFFFF;fontSize=15;fontStyle=1;fontColor=#1A1A1A;collapsible=0;whiteSpace=wrap;strokeWidth=1.5;" vertex="1" parent="agents"><mxGeometry x="292" y="64" width="512" height="667" as="geometry"/></mxCell>
<mxCell id="c40" value="Clinical evidence: case record and notes search" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c39"><mxGeometry x="14" y="50" width="484" height="40" as="geometry"/></mxCell>
<mxCell id="c41" value="Policy RAG: policy rules and policy-text search" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c39"><mxGeometry x="14" y="99" width="484" height="40" as="geometry"/></mxCell>
<mxCell id="c42" value="Coverage &amp; eligibility: coverage and past authorizations" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c39"><mxGeometry x="14" y="148" width="484" height="40" as="geometry"/></mxCell>
<mxCell id="c43" value="Criteria &amp; quality: matches facts to criteria and checks the answer format" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c39"><mxGeometry x="14" y="197" width="484" height="54" as="geometry"/></mxCell>
<mxCell id="c44" value="All tool calls go through the LiteLLM MCP gateway (model calls time out after 150 s, tools after 15 s / 90 s)" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c39"><mxGeometry x="14" y="260" width="484" height="54" as="geometry"/></mxCell>
<mxCell id="c45" value="They do not read memory. Prompts for all agents are loaded from Langfuse at startup" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c39"><mxGeometry x="14" y="323" width="484" height="54" as="geometry"/></mxCell>
<mxCell id="c46" value="Memory agent" style="swimlane;html=1;rounded=1;arcSize=9;startSize=38;fillColor=#F8CECC;strokeColor=#B85450;swimlaneFillColor=#FFFFFF;fontSize=15;fontStyle=1;fontColor=#1A1A1A;collapsible=0;whiteSpace=wrap;strokeWidth=1.5;" vertex="1" parent="agents"><mxGeometry x="828" y="64" width="250" height="667" as="geometry"/></mxCell>
<mxCell id="c47" value="Handles remember / prefer (save) and what-do-you-remember requests. Recall for a review happens inside run_review" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c46"><mxGeometry x="14" y="50" width="222" height="86" as="geometry"/></mxCell>
<mxCell id="c48" value="Only agent with memory tools. Holds preferences and overrides, never case results" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c46"><mxGeometry x="14" y="145" width="222" height="70" as="geometry"/></mxCell>
<mxCell id="c49" value="Recalled preferences only word the answer; an override is shown as the reviewer's standing rule. The recommendation does not change" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c46"><mxGeometry x="14" y="224" width="222" height="102" as="geometry"/></mxCell>
<mxCell id="memobs" value="Memory &amp; Observability" style="swimlane;html=1;rounded=1;arcSize=5;startSize=46;fillColor=#DAE8FC;strokeColor=#6C8EBF;swimlaneFillColor=#FFFFFF;fontSize=20;fontStyle=1;fontColor=#1A1A1A;collapsible=0;whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1670" y="576" width="366" height="749" as="geometry"/></mxCell>
<mxCell id="c50" value="mem0  ·  :8200" style="swimlane;html=1;rounded=1;arcSize=9;startSize=38;fillColor=#F8CECC;strokeColor=#B85450;swimlaneFillColor=#FFFFFF;fontSize=15;fontStyle=1;fontColor=#1A1A1A;collapsible=0;whiteSpace=wrap;strokeWidth=1.5;" vertex="1" parent="memobs"><mxGeometry x="18" y="64" width="330" height="133" as="geometry"/></mxCell>
<mxCell id="c51" value="Saves preferences and overrides only, never case results. A repeated fact replaces the old one" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c50"><mxGeometry x="14" y="50" width="302" height="70" as="geometry"/></mxCell>
<mxCell id="c52" value="Langfuse tracing  ·  :3000" style="swimlane;html=1;rounded=1;arcSize=9;startSize=38;fillColor=#F8CECC;strokeColor=#B85450;swimlaneFillColor=#FFFFFF;fontSize=15;fontStyle=1;fontColor=#1A1A1A;collapsible=0;whiteSpace=wrap;strokeWidth=1.5;" vertex="1" parent="memobs"><mxGeometry x="18" y="221" width="330" height="133" as="geometry"/></mxCell>
<mxCell id="c53" value="Tracing and observability: every model and tool call, grouped by session, with the real model name and cache hits" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c52"><mxGeometry x="14" y="50" width="302" height="70" as="geometry"/></mxCell>
<mxCell id="c54" value="Langfuse prompts  ·  :3000" style="swimlane;html=1;rounded=1;arcSize=9;startSize=38;fillColor=#F8CECC;strokeColor=#B85450;swimlaneFillColor=#FFFFFF;fontSize=15;fontStyle=1;fontColor=#1A1A1A;collapsible=0;whiteSpace=wrap;strokeWidth=1.5;" vertex="1" parent="memobs"><mxGeometry x="18" y="378" width="330" height="133" as="geometry"/></mxCell>
<mxCell id="c55" value="Agent prompts with version history. Edit in the screen, agents load the live version at startup" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c54"><mxGeometry x="14" y="50" width="302" height="70" as="geometry"/></mxCell>
<mxCell id="c56" value="Langfuse evaluation  ·  :3000" style="swimlane;html=1;rounded=1;arcSize=9;startSize=38;fillColor=#F8CECC;strokeColor=#B85450;swimlaneFillColor=#FFFFFF;fontSize=15;fontStyle=1;fontColor=#1A1A1A;collapsible=0;whiteSpace=wrap;strokeWidth=1.5;" vertex="1" parent="memobs"><mxGeometry x="18" y="535" width="330" height="196" as="geometry"/></mxCell>
<mxCell id="c57" value="Datasets: question + labelled answer, retrieval and reasoning (run_eval.py)" style="rounded=1;html=1;arcSize=16;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="c56"><mxGeometry x="14" y="50" width="302" height="54" as="geometry"/></mxCell>
