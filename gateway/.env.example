# Copied to .env by install.py (which fills in the generated values). Never commit the real .env.
GOOGLE_API_KEY={{GOOGLE_API_KEY}}
# Optional. install.py writes a placeholder if you skip it; Groq calls then fail and LiteLLM falls back to Gemini.
GROQ_API_KEY={{GROQ_API_KEY}}
MCP_API_TOKEN={{MCP_API_TOKEN}}
# LiteLLM Admin UI login
UI_USERNAME={{UI_USERNAME}}
UI_PASSWORD={{UI_PASSWORD}}
LITELLM_MASTER_KEY={{LITELLM_MASTER_KEY}}
# LiteLLM database: the postgres container from docker-compose.yml, database "litellm" (install.py creates it)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/litellm
